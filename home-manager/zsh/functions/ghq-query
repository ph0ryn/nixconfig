#!/usr/bin/env zsh

# ghq-query [owner] [ghq get args...]

local owner="${1:-}" login query full_name target
local -a ghq_args

login="$(gh api user --jq .login 2>/dev/null)" || {
  echo "ghq-query: failed to get authenticated GitHub user" >&2
  return 1 2>/dev/null || exit 1
}

if [[ -z "$owner" || "$owner" == -* ]]; then
  owner="$login"
  ghq_args=("$@")
else
  shift
  ghq_args=("$@")
fi

query='
  query($owner: String!) {
    repositoryOwner(login: $owner) {
      repositories(
        first: 100
        orderBy: { field: UPDATED_AT, direction: DESC }
      ) {
        nodes {
          nameWithOwner
          isPrivate
          updatedAt
        }
      }
    }
  }
'

full_name=$(
  gh api graphql \
    -f owner="$owner" \
    -f query="$query" \
    --jq '
      .data.repositoryOwner.repositories.nodes[]?
      | [
          .nameWithOwner,
          (if .isPrivate then "private" else "public" end),
          .updatedAt
        ]
      | @tsv
    ' |
    awk -F '\t' '
      {
        name[NR] = $1
        vis[NR] = $2
        updated[NR] = $3

        if (length($1) > max) {
          max = length($1)
        }
      }

      END {
        for (i = 1; i <= NR; i++) {
          if (vis[i] == "private") {
            label = "\033[1;35mprivate\033[0m"
          } else {
            label = "\033[2;37mpublic \033[0m"
          }

          printf "%s\t%-*s  %s\n", name[i], max, name[i], label
        }
      }
    ' |
    fzf \
      --ansi \
      --prompt="repo> " \
      --height=40% \
      --layout=reverse \
      --border \
      --delimiter=$'\t' \
      --with-nth=2 |
    cut -f1
) || {
  return 0 2>/dev/null || exit 0
}

[[ -z "$full_name" ]] && {
  return 0 2>/dev/null || exit 0
}

ghq get "git@github.com:${full_name}.git" "${ghq_args[@]}" || {
  return 1 2>/dev/null || exit 1
}

target="$(ghq list -p -e "github.com/${full_name}" | head -n 1)"
[[ -z "$target" ]] && {
  return 1 2>/dev/null || exit 1
}

cd -- "$target"
